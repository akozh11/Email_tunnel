{
  "poll_interval_seconds": 15,
  "gemini_model": "gemini-3.5-flash-lite",
  "max_replies_per_sender_per_hour": 10,
  "max_messages_per_cycle": 20,

  "accounts": [
    {
      "name": "gmail_self",
      "mail_user": "${GMAIL_USER}",
      "mail_pass": "${GMAIL_PASS}",
      "imap_server": "imap.gmail.com",
      "imap_port": 993,
      "smtp_server": "smtp.gmail.com",
      "smtp_port": 465,
      "smtp_use_ssl": true,
      "self_only": true,
      "reply_mode": "append_inbox",
      "process_backlog_on_first_run": true,
      "poll_interval_seconds": 15
    },
    {
      "name": "mailru_external",
      "mail_user": "${MAILRU_USER}",
      "mail_pass": "${MAILRU_PASS}",
      "imap_server": "imap.mail.ru",
      "imap_port": 993,
      "smtp_server": "smtp.mail.ru",
      "smtp_port": 465,
      "smtp_use_ssl": true,
      "self_only": false,
      "reply_mode": "smtp",
      "process_backlog_on_first_run": false,
      "poll_interval_seconds": 20,
      "max_replies_per_sender_per_hour": 5
    }
  ]
}